{
  "mcpServers": {
    "excel": {
      "command": "cmd",
      "args": ["/c", "npx", "--yes", "@negokaz/excel-mcp-server"],
      "env": {}
    },
    "airbnb": {
      "command": "npx",
      "args": ["-y", "@openbnb/mcp-server-airbnb", "--ignore-robots-txt"]
    },
    "youtube-music": {
      "command": "npx",
      "args": ["-y", "@instructa/mcp-youtube-music"],
      "env": {
        "YOUTUBE_API_KEY": "여기에_키_입력_또는_빈문자열"
      }
    },
    "firecrawl-mcp": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "여기에_키_입력_또는_빈문자열"
      }
    },
    "allpepper-memory-bank": {
      "command": "npx",
      "args": ["-y", "@allpepper/memory-bank-mcp"],
      "env": {
        "MEMORY_BANK_ROOT": "C:\\mcptools\\memory-bank"
      }
    },
    "paper-search-mcp": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "mcp-remote", "https://server.smithery.ai/@openags/paper-search-mcp/mcp"],
      "env": {
        "SEMANTIC_SCHOLAR_API_KEY": ""
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    }
  },
  "preferences": {
    "chromeExtensionEnabled": true
  }
}
